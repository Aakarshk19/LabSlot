# Server
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/labslot
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/labslot_test

# Auth — generate a long random value. Never commit the real secret.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Cookies: set COOKIE_SECURE=true behind HTTPS in production
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Browser origin used by CORS when the API is hosted separately from the UI
CLIENT_ORIGIN=http://localhost:5173

# Booking workflow: true = new bookings start as PENDING and need admin approval
REQUIRE_BOOKING_APPROVAL=false

# First-run administrator (used only by the seed/bootstrap script)
ADMIN_NAME=Lab Administrator
ADMIN_EMAIL=admin@labslot.local
ADMIN_PASSWORD=ChangeThisAdminPassword1

# Client (Vite). Leave empty in local development so the Vite proxy is used
# and cookies stay same-origin. In production, set the public API origin.
VITE_API_BASE_URL=
